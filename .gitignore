/target
ui/node_modules/
ui/dist/
# ts-rs output — regenerated by `cargo test -p surge-domain` (never hand-edit)
ui/src/generated/*
!ui/src/generated/.gitkeep
# local databases
*.db
*.db-shm
*.db-wal
.env
.dev.db*
# ts-rs default output dir (canonical output is ui/src/generated/)
crates/*/bindings/
*.tsbuildinfo
